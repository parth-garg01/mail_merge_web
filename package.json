{
  "name": "smart-mail-merger-web",
  "version": "1.0.0",
  "description": "Smart Mail Merger — web application version",
  "scripts": {
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite client --port 3000",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "build": "vite build client --outDir ../server/public --emptyOutDir",
    "start": "node server/index.js"
  },
  "keywords": [
    "email",
    "mail-merge",
    "gmail",
    "automation"
  ],
  "author": "Parth Garg",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "googleapis": "^144.0.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1",
    "ws": "^8.16.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4"
  }
}
