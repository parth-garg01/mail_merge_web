# Server port (default: 5000)
PORT=5000

# Set to "production" on a hosted server. The app then refuses to start without a password.
NODE_ENV=

# Password for the app. Required when NODE_ENV=production (8+ characters).
# It only seeds the first password; change it later from the Settings page.
APP_PASSWORD=

# Where campaigns, queues, logs and the Google token are stored.
# On a host, point this at a persistent disk. Default: ~/.smart-mail-merger-web
DATA_DIR=

# Public address of the app, used to build the Google redirect URI
# (PUBLIC_URL + /oauth2callback). Render fills this in by itself.
# Example: https://mail.example.com
PUBLIC_URL=

# Google OAuth credentials (can also be entered on the Settings page)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Timezone for sending windows and start times, for example Asia/Kolkata.
# Hosted servers run in UTC unless this is set.
# TZ=Asia/Kolkata

# Minutes between checks of linked Google Sheets for new rows (default: 5)
SHEET_SYNC_MINUTES=

# Session secret (optional): a random one is generated and saved on first run
SESSION_SECRET=
