# Server port (default: 5000)
PORT=5000

# Session secret (optional): a random one is generated and saved on first run
SESSION_SECRET=

# Google OAuth credentials (can also be set via the Settings page)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redirect URI — must match what you registered in Google Cloud Console
# Dev:  http://localhost:5000/oauth2callback
# Prod: https://yourdomain.com/oauth2callback
REDIRECT_URI=http://localhost:5000/oauth2callback

# Password for the app. Required when NODE_ENV=production (8+ characters).
# It only seeds the first password; change it later from the Settings page.
APP_PASSWORD=
